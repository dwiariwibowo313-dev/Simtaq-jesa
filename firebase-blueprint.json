    "Announcement": {
      "title": "Announcement",
      "description": "School or teacher announcement targeted by role/class/halaqah.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
