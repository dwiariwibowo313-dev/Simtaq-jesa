      "properties": {
        "id": { "type": "string", "maxLength": 40, "pattern": "^sdn-jetiskarangpung-1$" },
        "school_id": { "type": "string", "maxLength": 40, "pattern": "^sdn-jetiskarangpung-1$" },
        "school_name": { "type": "string", "minLength": 3, "maxLength": 120 },
        "slogan": { "type": "string", "minLength": 3, "maxLength": 200 },
        "logo_data_url": { "type": "string", "maxLength": 400000 },
        "app_version": { "type": "string", "maxLength": 32 },
        "auto_sync_enabled": { "type": "boolean" },
        "sync_interval_minutes": { "type": "number" },
        "updated_by": { "type": "string", "maxLength": 120 },
        "updated_at": { "type": "string", "format": "timestamp" }
      },
      "required": ["id", "school_id", "school_name", "slogan", "app_version", "auto_sync_enabled", "sync_interval_minutes", "updated_by", "updated_at"]
    },
    "ClassRoom": {
