{
  "entities": {
    "SystemBootstrap": {
      "title": "SystemBootstrap",
      "description": "Atomic one-time lock document binding the primary Super Admin account to a single verified Firebase Auth UID.",
      "type": "object",
      "properties": {
        "super_admin_uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 160, "pattern": "^dwiariwibowo313@gmail\\.com$" },
        "school_id": { "type": "string", "maxLength": 40, "pattern": "^sdn-jetiskarangpung-1$" },
        "bootstrapped_at": { "type": "string", "format": "timestamp" }
      },
      "required": ["super_admin_uid", "email", "school_id", "bootstrapped_at"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Privileged admin marker keyed by Firebase Auth UID for zero-escalation role verification.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["super_admin", "school_admin"] },
        "school_id": { "type": "string", "maxLength": 40, "pattern": "^sdn-jetiskarangpung-1$" },
        "created_at": { "type": "string", "format": "timestamp" }
      },
      "required": ["uid", "role", "school_id", "created_at"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated user profile with isolated email PII and server-enforced RBAC role.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 5, "maxLength": 160 },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["super_admin", "school_admin", "teacher", "student", "guardian"] },
        "school_id": { "type": "string", "maxLength": 40, "pattern": "^sdn-jetiskarangpung-1$" },
        "is_active": { "type": "boolean" },
        "linked_entity_id": { "type": "string", "maxLength": 128 },
        "email_verified": { "type": "boolean" },
        "created_at": { "type": "string", "format": "timestamp" },
        "updated_at": { "type": "string", "format": "timestamp" }
      },
      "required": ["uid", "email", "display_name", "role", "school_id", "is_active", "email_verified", "created_at", "updated_at"]
    },
    "SchoolSettings": {
      "title": "SchoolSettings",
