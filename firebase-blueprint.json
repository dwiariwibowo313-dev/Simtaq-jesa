  "firestore": {
    "/system_bootstrap/{docId}": {
      "schema": { "$ref": "#/entities/SystemBootstrap" },
      "description": "One-time atomic Super Admin lock document (id: super_admin)."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Trusted admin marker documents for Super Admin and School Admin."
    },
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Authenticated user account and RBAC role assignment."
    },
    "/school_settings/{schoolId}": {
      "schema": { "$ref": "#/entities/SchoolSettings" },
      "description": "Single-school configuration locked to sdn-jetiskarangpung-1."
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/ClassRoom" },
      "description": "Class master data for SDN Jetiskarangpung 1."
    },
    "/halaqahs/{halaqahId}": {
      "schema": { "$ref": "#/entities/Halaqah" },
      "description": "Halaqah master data for SDN Jetiskarangpung 1."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Student master records scoped to SDN Jetiskarangpung 1."
    },
    "/guardians/{guardianId}": {
      "schema": { "$ref": "#/entities/Guardian" },
      "description": "Guardian PII contact records isolated from unauthorized access."
    },
    "/teacher_assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/TeacherAssignment" },
      "description": "Assigned classes, halaqahs, and students per teacher UID."
    },
    "/tahfidz_targets/{targetId}": {
      "schema": { "$ref": "#/entities/TahfidzTarget" },
      "description": "Tahfidz memorization targets."
    },
    "/memorization_records/{recordId}": {
      "schema": { "$ref": "#/entities/MemorizationRecord" },
      "description": "Student memorization assessment records."
    },
    "/murajaah_records/{recordId}": {
      "schema": { "$ref": "#/entities/MurajaahRecord" },
      "description": "Student murajaah review records."
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "School and teacher announcements."
    },
    "/announcement_reads/{readId}": {
      "schema": { "$ref": "#/entities/AnnouncementRead" },
      "description": "Per-user read receipts for announcements."
    },
    "/quiz_results/{resultId}": {
      "schema": { "$ref": "#/entities/QuizResult" },
      "description": "Tajwid and MAPSi quiz outcomes."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Append-only security and assessment audit logs."
    }
  }
}
